# === Base de datos ===
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/retail_dashboard

# === Redis ===
REDIS_URL=redis://localhost:6379

# === ERP Gateway ===
ERP_PROVIDER=mock
ERP_MOCK_URL=http://localhost:4010

# === Servicios ===
INGESTION_INTERVAL_MS=600000
INGESTION_OVERLAP_MINUTES=15
INGESTION_BATCH_SIZE=500

# === Analytics ===
CACHE_FRESH_MS=60000
CACHE_STALE_MS=600000
STATEMENT_TIMEOUT_MS=10000
MAX_EXPORT_ROWS=100000

# === API Gateway ===
API_PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# === Frontend ===
VITE_API_URL=http://localhost:3000/api
